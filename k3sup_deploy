#!/bin/bash
set -e

#export CHANNEL="v1.27.4+k3s1"
export CHANNEL="latest"
export MASTER_1="archserv01.whezzel.com"
export MASTER_2="archserv02.whezzel.com"
export MASTER_3="archserv03.whezzel.com"
export AGENT_1="archserv04.whezzel.com"
export AGENT_2="archserv05.whezzel.com"
export USER=root

k3sup install \
  --cluster \
  --user $USER \
  --host $MASTER_1 \
  --local-path "$HOME/.kube/config" \
  --merge \
  --context prod \
  --k3s-channel $CHANNEL \
  --print-command \
  --print-config \
  --ssh-key "/home/zach/.ssh/root.id_rsa" \
  --k3s-extra-args '--write-kubeconfig-mode 664 --tls-san k3s-api.whezzel.com --tls-san archserv01.whezzel.com --flannel-backend=none --disable-network-policy --disable traefik'

k3sup join \
  --server \
  --host $MASTER_2 \
  --user $USER \
  --server-user $USER \
  --server-host $MASTER_1 \
  --k3s-channel $CHANNEL \
  --print-command \
  --ssh-key "/home/zach/.ssh/root.id_rsa" \
  --k3s-extra-args '--write-kubeconfig-mode 664 --tls-san k3s-api.whezzel.com --tls-san archserv01.whezzel.com --flannel-backend=none --disable-network-policy --disable traefik'

k3sup join \
  --server \
  --host $MASTER_3 \
  --user $USER \
  --server-user $USER \
  --server-host $MASTER_1 \
  --k3s-channel $CHANNEL \
  --print-command \
  --ssh-key "/home/zach/.ssh/root.id_rsa" \
  --k3s-extra-args '--write-kubeconfig-mode 664 --tls-san k3s-api.whezzel.com --tls-san archserv01.whezzel.com --flannel-backend=none --disable-network-policy --disable traefik'

k3sup join \
 --server-host archserv01.whezzel.com \
  --host $AGENT_1 \
  --user $USER \
  --server-user $USER \
  --server-host $MASTER_1 \
  --k3s-channel $CHANNEL \
  --print-command \
  --ssh-key "/home/zach/.ssh/root.id_rsa"

k3sup join \
  --server-host archserv01.whezzel.com \
  --host $AGENT_2 \
  --user $USER \
  --server-user $USER \
  --server-host $MASTER_1 \
  --k3s-channel $CHANNEL \
  --print-command \
  --ssh-key "/home/zach/.ssh/root.id_rsa"
